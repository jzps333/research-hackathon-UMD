# ==============================================================================
# OpenRouter Multi-Model Processor Configuration
# ==============================================================================

# Master OpenRouter API Key (fallback if individual keys are not provided)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Optional App Headers (for OpenRouter rankings/analytics)
OPENROUTER_SITE_URL=https://github.com/jzps333/research-hackathon-UMD
OPENROUTER_SITE_NAME=APIProcessor

# ==============================================================================
# 1. OpenAI: GPT-6 Luna Decisions
# OpenRouter Link: https://openrouter.ai/models/openai/gpt-6-luna-decisions
# ==============================================================================
OPENAI_API_KEY=your_openai_or_openrouter_key_here
OPENAI_MODEL_ID=openai/gpt-6-luna-decisions
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT_SECONDS=60
OPENAI_RATE_LIMIT_DELAY=1.0

# ==============================================================================
# 2. Meta: Muse Spark 1.3
# OpenRouter Link: https://openrouter.ai/models/meta/muse-spark-1.3
# ==============================================================================
META_API_KEY=your_meta_or_openrouter_key_here
META_MODEL_ID=meta/muse-spark-1.3
META_MAX_TOKENS=8192
META_TEMPERATURE=0.2
META_TIMEOUT_SECONDS=90
META_RATE_LIMIT_DELAY=1.0

# ==============================================================================
# 3. Google: Gemini 3.7 Flash
# OpenRouter Link: https://openrouter.ai/models/google/gemini-3.7-flash
# ==============================================================================
GOOGLE_API_KEY=your_google_or_openrouter_key_here
GOOGLE_MODEL_ID=google/gemini-3.7-flash
GOOGLE_MAX_TOKENS=4096
GOOGLE_TEMPERATURE=0.15
GOOGLE_TIMEOUT_SECONDS=60
GOOGLE_RATE_LIMIT_DELAY=1.0

# ==============================================================================
# LLM Judge (never routed through OpenRouter)
# JUDGE_PROVIDER=anthropic -> Claude Haiku 5.5 (default, fast)
# JUDGE_PROVIDER=nvidia    -> GLM 5.3 via https://build.nvidia.com (slow free tier)
# ==============================================================================
JUDGE_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
# JUDGE_MODEL_ID=            # optional override of the provider's default model
JUDGE_EFFORT=low
JUDGE_MAX_TOKENS=16000
JUDGE_TIMEOUT_SECONDS=300
JUDGE_MAX_RETRIES=3
